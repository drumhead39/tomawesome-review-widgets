{
  "name": "tomawesome/tomawesome-review-widgets",
  "description": "Unlimited review widgets for Google Business Profile and Places sources.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/php-compatibility": "^10.0@alpha",
    "phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha",
    "phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist",
    "test": "phpunit --configuration phpunit.xml.dist",
    "quality": [
      "@lint",
      "@test"
    ]
  }
}
