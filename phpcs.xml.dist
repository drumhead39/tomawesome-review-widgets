<?xml version="1.0"?>
<ruleset name="TomAwesome Review Widgets">
	<description>WordPress.org coding standards for TomAwesome Review Widgets.</description>

	<file>tomawesome-review-widgets.php</file>
	<file>includes</file>
	<file>uninstall.php</file>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP">
		<include-pattern>*.php</include-pattern>
	</rule>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="6.2"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="tomawesome-review-widgets"/>
			</property>
		</properties>
	</rule>

	<exclude-pattern>vendor/*</exclude-pattern>
</ruleset>
